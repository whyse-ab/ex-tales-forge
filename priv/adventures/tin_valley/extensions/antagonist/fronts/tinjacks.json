  "moves": {
    "incident": {
      "public_fact": {
        "id": "tinjacks_watchman",
        "text": "Last night someone clubbed the Guild's night watchman and took tin ingots from the weighing shed. Muddy boot prints lead west along the road, and there is no orc sign.",
        "visibility": [
          "market_square",
          "valley_inn",
          "inn_yard",
          "smithy",
          "herb_cottage"
        ]
      }
    },
    "toll": {
      "move_people": {
        "rusk": "valley_inn",
        "cobb": "valley_inn"
      },
      "public_fact": {
        "id": "tinjacks_toll",
        "text": "Rusk and his brute Cobb have come down from the west road and are collecting a 'road toll' at the Valley Inn: coin from Brenna and every guest, or a beating.",
        "visibility": [
          "valley_inn",
          "inn_yard",
          "market_square"
        ]
      }
    },
    "toll_taken": {
      "move_people": {
        "rusk": "@player",
        "cobb": "@player"
      },
      "player_out_of_reach": [
        "orc_approach",
        "orc_nest"
      ],
      "player_fallback": "valley_inn",
      "public_facts": [
        {
          "id": "tinjacks_toll_taken",
          "text": "While the stranger was out, Rusk and his brute Cobb came down to the Valley Inn and took a 'road toll' from Brenna's till and from every guest. Tam talked back and got a split lip for it. Rusk asked where the stranger who hasn't paid had gone.",
          "visibility": [
            "valley_inn",
            "inn_yard",
            "market_square",
            "smithy",
            "herb_cottage"
          ]
        },
        {
          "id": "tinjacks_seek",
          "text": "Rusk and Cobb have come for the stranger who missed the road toll at the inn. Rusk smiles and wants the stranger's share, coin or blood; Cobb has his club out.",
          "visibility": [
            "@player"
          ]
        }
      ],
      "people_memories": {
        "innkeep": {
          "who": "rusk",
          "what": "took a road toll from my till while the stranger was out, and asked where the stranger had gone",
          "felt": "afraid"
        },
        "stable_lad": {
          "who": "cobb",
          "what": "split my lip when I talked back over the road toll",
          "felt": "angry"
        }
      }
    },
    "burning": {
      "move_people": {
        "rusk": "old_adit",
        "cobb": "old_adit"
      },
      "public_fact": {
        "id": "tinjacks_burning",
        "text": "The Tinjacks set Mags Ferrow's wagon alight in the inn yard as a warning to anyone who won't pay, then went back up the west road. The village is frightened and angry.",
        "visibility": [
          "valley_inn",
          "inn_yard",
          "market_square",
          "smithy",
          "herb_cottage",
          "west_road"
        ]
      },
      "retract_facts": [
        "tinjacks_toll",
        "tinjacks_seek"
      ]
    },
    "stand_ready": {
      "public_fact": {
        "id": "tinjacks_ready",
        "text": "A whistle from the pines warned the adit: Rusk and Cobb stand ready in its mouth, blades out.",
        "visibility": [
          "old_adit"
        ]
      }
    },
    "gloat": {
      "memory": {
        "who": "player",
        "what": "the stranger tried us and bled for it",
        "felt": "contempt"
      }
    },
    "pip_turned": {
      "move_people": {
        "pip": "herb_cottage"
      },
      "public_fact": {
        "id": "tinjacks_pip_home",
        "text": "Pip has left the Tinjacks and gone home to his grandmother Maude. He says Rusk keeps the stolen salt and ingots in the old adit and sleeps there by day.",
        "visibility": [
          "herb_cottage",
          "market_square",
          "valley_inn",
          "inn_yard",
          "west_road",
          "old_adit"
        ]
      }
    },
    "broken": {
      "status": "spent",
      "move_people": {
        "rusk": "gone",
        "cobb": "gone"
      },
      "public_fact": {
        "id": "tinjacks_broken",
        "text": "The Tinjacks are broken: Rusk fled down-valley, Cobb sits in the Guild's lock-up, and the stolen salt and ingots are stacked in the old adit. Osric Vane pays 2 silver for each Tinjack brought down, Mags wants her salt, and the village talks of little else.",
        "visibility": [
          "valley_inn",
          "inn_yard",
          "market_square",
          "smithy",
          "herb_cottage",
          "west_road",
          "old_adit",
          "mine_workings"
        ]
      },
      "people_memories": {
        "innkeep": {
          "who": "player",
          "what": "broke the Tinjacks who squeezed my inn for a toll",
          "felt": "grateful"
        },
        "guild_steward": {
          "who": "player",
          "what": "brought down the Tinjacks; the Guild owes the bounty",
          "felt": "owed"
        },
        "drover": {
          "who": "player",
          "what": "broke the gang that stole my salt",
          "felt": "grateful"
        }
      },
      "retract_facts": [
        "tinjacks_toll",
        "tinjacks_seek",
        "tinjacks_ready",
        "tinjacks_rumour"
      ]
    }
  },
  "public_facts": [
    {
      "id": "tinjacks_rumour",
      "text": "Drovers grumble that another salt cart vanished on the west road; folk blame the orcs, though orcs never come down that far.",
      "visibility": [
        "valley_inn",
        "inn_yard",
        "market_square"
      ]
    }
  ],
