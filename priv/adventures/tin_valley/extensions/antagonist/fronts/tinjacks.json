      },
      "public_fact": {
        "id": "tinjacks_toll",
        "text": "Rusk and his brute Cobb have come down from the west road and are collecting a 'road toll' at the Valley Inn: coin from Brenna and every guest, or a beating.",
        "visibility": [
          "valley_inn",
          "inn_yard",
          "market_square"
        ]
      }
    },
