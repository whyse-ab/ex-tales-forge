# Local development secrets
# Copy this file to .env and fill in your values. Never commit .env.
#
#   cp .env.example .env

# Required for live Grok GM responses (get a key at https://console.x.ai)
XAI_API_KEY=

# xAI-only: fast non-reasoning Grok for all tiers (no thinking models)
LLM_PROVIDER=xai
XAI_MODEL=grok-4.20-0309-non-reasoning

# Optional LLM tuning
# TIER1_MAX_TOKENS=400
# TIER2_MAX_TOKENS=700
# TIER1_HEURISTIC_THRESHOLD=0.85

# Admin console at /admin — email magic-link allowlist (comma-separated)
ADMIN_EMAILS=you@example.com,cofounder@example.com
# ADMIN_MAIL_FROM=admin@tales-forge.ai

# Local path to tales-forge-docs checkout (used by Sync / mix tales.sync_docs)
# TALES_FORGE_DOCS_PATH=/workspace/tales-forge-docs-git

# Or fetch private docs repo via GitHub API
# GITHUB_DOCS_TOKEN=

# Optional: override the default local Postgres connection from config/dev.exs
# DATABASE_URL=ecto://postgres:postgres@localhost/ex_tales_forge_dev

# Production / Fly.io (not needed for local dev)
# SECRET_KEY_BASE=
# PHX_HOST=tales-forge.fly.dev
# MAIL_ADAPTER=resend
# RESEND_API_KEY=
# or: MAIL_ADAPTER=postmark / POSTMARK_API_KEY=

# Phase 2+ object storage (Tigris on Fly.io — S3 compatible)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# BUCKET_NAME=tales-forge-images
